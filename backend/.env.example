# Google Gemini AI Model & Embeddings Configuration
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Google Gemini API Key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Serverless Vector Database
PINECONE_INDEX_NAME=cloudops-sentinel-gemini-self-rag
PINECONE_NAMESPACE=incident-runbooks
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Tavily Search API (Fallback Internet Search)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cloudops-sentinel

# Self-RAG Thresholds & Graph Controls
TOP_K=5
MAX_SUPPORT_RETRIES=2
MAX_RETRIEVAL_REWRITES=2
MAX_WEB_REWRITES=2
DATABASE_PATH=data/audit.db
