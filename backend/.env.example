# OpenAI Model & Embeddings Configuration
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Serverless Vector Database
PINECONE_INDEX_NAME=cloudops-sentinel-openai-self-rag
PINECONE_NAMESPACE=incident-runbooks
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Tavily Search API (Fallback Internet Search)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cloudops-sentinel

# Self-RAG Thresholds & Graph Controls
TOP_K=5
MAX_SUPPORT_RETRIES=2
MAX_RETRIEVAL_REWRITES=2
MAX_WEB_REWRITES=2
DATABASE_PATH=data/audit.db

# Database Configuration (Neon PostgreSQL via SQLAlchemy)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-proud-thunder-b46b3rk4-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
